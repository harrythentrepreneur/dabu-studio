# Environment Configuration Template
# Copy this to .env and fill in your actual values

# ===========================================
# CORE API KEYS (REQUIRED)
# ===========================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# DIGITAL OCEAN SPACES (REQUIRED FOR CLOUD)
# ===========================================
DO_SPACES_KEY=your_do_spaces_key_here
DO_SPACES_SECRET=your_do_spaces_secret_here
DO_SPACES_BUCKET=your-bucket
DO_SPACES_REGION=sfo3
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com

# ===========================================
# RUNPOD CONFIGURATION (FOR HEAVY PROCESSING)
# ===========================================
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here

# ===========================================
# DEPLOYMENT CONFIGURATION
# ===========================================
# Options: LOCAL, HYBRID, PRODUCTION
ENVIRONMENT_MODE=HYBRID

# Frontend URLs (local development)
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001
NEXT_PUBLIC_CLOUD=true

# Ports for local development
FRONTEND_PORT=3000
BACKEND_PORT=5001

# ===========================================
# OPTIONAL SETTINGS
# ===========================================
# Local Docker processing (for development)
USE_LOCAL_DOCKER=true
LOCAL_DOCKER_URL=http://runpod-worker:8000

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false

# Flask settings
FLASK_ENV=production
FLASK_DEBUG=0