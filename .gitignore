# production
/build
frontend/build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.claude

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python backend
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/logs/
backend/temp/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/htmlcov/
backend/.coverage
backend/*.egg-info/

# Video files - Input videos (large source files)
input_videos/

# Temporary processing files (cleaned up after 1 hour)
backend/temp/

# Output videos (keep these for user downloads, but don't track in git)
backend/output/
output/

# Large video files anywhere in the project
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.AVI
*.mkv
*.webm

# GIF files
*.gif
*.GIF

# ZIP archives (often large capcut projects)
*.zip
*.ZIP

# Backup files
*.backup
*.bak
.git-rewrite/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

