# Lightweight Flask Backend Dockerfile
# This runs the API server that delegates heavy processing to RunPod

FROM python:3.11-slim

# Install only essential system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.lightweight.txt .
RUN pip install --no-cache-dir -r requirements.lightweight.txt

# Copy application code
COPY app.py .
COPY api/ api/
COPY utils/logger.py utils/
COPY utils/config.py utils/
COPY runpod_client/ runpod_client/

# Create necessary directories
RUN mkdir -p logs temp

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# Run as non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 5000

# Start Flask app
CMD ["python", "app.py"]