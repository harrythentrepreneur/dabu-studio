# RunPod Optimized Dockerfile for Express Builder & Quick Create
# Supports both CPU and GPU instances

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    wget \
    curl \
    gnupg \
    unzip \
    xvfb \
    x11vnc \
    fluxbox \
    chromium \
    chromium-driver \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libgbm1 \
    libasound2 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements-runpod.txt .
RUN pip install --no-cache-dir -r requirements-runpod.txt

# Copy only necessary backend code
COPY runpod/ ./runpod/
COPY core/ ./core/
COPY services/ ./services/
COPY business/ ./business/
COPY config/ ./config/
COPY utils/ ./utils/
COPY main.py ./
COPY runpod_handler.py ./

# Create necessary directories
RUN mkdir -p /app/temp /app/output /app/logs

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV DISPLAY=:99
ENV PYTHONPATH=/app

# RunPod handler entry point
CMD ["python", "-u", "runpod/worker/main_handler.py"]