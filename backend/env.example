# =============================================================================
# DABU BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env for local development or set in RunPod environment
# cp env.example .env

# =============================================================================
# RUNPOD DEPLOYMENT CONFIGURATION
# =============================================================================
# RunPod specific environment variables
RUNPOD_POD_ID=${RUNPOD_POD_ID}
RUNPOD_API_KEY=${RUNPOD_API_KEY}
RUNPOD_ENDPOINT_ID=${RUNPOD_ENDPOINT_ID}

# =============================================================================
# DIGITAL OCEAN SPACES CONFIGURATION
# =============================================================================
# Storage configuration for input/output files
STORAGE_PROVIDER=digitalocean
DO_SPACES_KEY=your_do_spaces_access_key_here
DO_SPACES_SECRET=your_do_spaces_secret_key_here
DO_SPACES_BUCKET=your-bucket
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================
# Google Gemini API for video analysis
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API for voiceover analysis (optional)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================
# Video processing settings
MAX_WORKERS=5
MAX_QUEUE_SIZE=1000
DEBUG_MODE=false

# =============================================================================
# CAPCUT AUTOMATION (optional)
# =============================================================================
# Windows machine IP for CapCut automation
CAPCUT_WINDOWS_IP=192.168.1.100
CAPCUT_API_KEY=your_capcut_api_key_here

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# =============================================================================
# SECURITY AND NETWORKING
# =============================================================================
# CORS settings for frontend communication
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000
API_RATE_LIMIT=100

# =============================================================================
# DEVELOPMENT OVERRIDES (only for local .env)
# =============================================================================
# Uncomment these for local development
# DEBUG_MODE=true
# LOG_LEVEL=DEBUG
# STORAGE_PROVIDER=local
# LOCAL_STORAGE_DIR=/tmp/dabu_storage

# =============================================================================
# SECURITY NOTES
# =============================================================================
# ⚠️  NEVER commit .env files to version control
# ⚠️  Keep your API keys secure
# ⚠️  Rotate keys regularly
# ⚠️  Use different keys for development/staging/production
# ⚠️  In RunPod, set these as environment variables, not in files
