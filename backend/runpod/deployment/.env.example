# RunPod Configuration
RUNPOD_API_KEY=your-runpod-api-key-here
RUNPOD_ENDPOINT_ID=your-endpoint-id-here
RUNPOD_BASE_URL=https://api.runpod.ai/v2
RUNPOD_TIMEOUT=600
RUNPOD_POLL_INTERVAL=2

# Docker Hub Configuration (for deployment)
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-password

# Worker Configuration
MAX_WORKERS=5
ENABLE_MONITORING=true
DEBUG_SCREENSHOTS=false

# GPU Selection (for RunPod dashboard)
# Options: T4, RTX3090, RTX4090, A100
PREFERRED_GPU=T4

# Cost Controls
MAX_IDLE_TIME=5  # seconds before scaling to 0
MAX_EXECUTION_TIME=600  # max seconds per job
ENABLE_FLASHBOOT=true  # faster cold starts