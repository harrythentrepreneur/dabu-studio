# Backend Environment Variables for RunPod
# Copy this file to .env and fill in your values

# ====================
# ENVIRONMENT MODE
# ====================
ENVIRONMENT_MODE=PRODUCTION  # LOCAL | HYBRID | PRODUCTION
USE_RUNPOD=true  # Use RunPod for processing

# ====================
# API KEYS
# ====================
# Google Gemini for AI video analysis
GEMINI_API_KEY=your-gemini-api-key

# OpenAI for Whisper voice analysis
OPENAI_API_KEY=your-openai-api-key

# ====================
# DIGITAL OCEAN SPACES
# ====================
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_REGION=sfo3
DO_SPACES_BUCKET=your-bucket
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com

# ====================
# CAPCUT AUTOMATION
# ====================
# Required for Quick Create caption feature
# WARNING: Do not commit real credentials to version control
CAPCUT_EMAIL=your-capcut-email
CAPCUT_PASSWORD=your-capcut-password

# ====================
# PROCESSING CONFIG
# ====================
TARGET_DURATION_DEFAULT=35
COMPRESSION_RATIO=30
MAX_VIDEO_SIZE_MB=500
MAX_SCRIPT_LENGTH=1000

# ====================
# WHISPER CONFIG
# ====================
WHISPER_MAX_SEGMENT_DURATION=7.0
WHISPER_MIN_SEGMENT_DURATION=2.5

# ====================
# DEBUG
# ====================
DEBUG_MODE=false