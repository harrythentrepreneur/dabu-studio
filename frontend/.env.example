# Frontend Environment Variables
# Copy this file to .env and fill in your values

# ====================
# NEXT.JS CONFIGURATION
# ====================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ====================
# DIGITAL OCEAN SPACES
# ====================
# S3-compatible storage for video files
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_BUCKET=your-bucket
DO_SPACES_REGION=sfo3
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com

# ====================
# RUNPOD CONFIGURATION
# ====================
# Serverless GPU for heavy processing
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id

# ====================
# GOOGLE GEMINI API
# ====================
# For GIF Studio and AI analysis
GEMINI_API_KEY=your-gemini-api-key

# ====================
# OPENAI API
# ====================
# For Whisper voice analysis (optional)
OPENAI_API_KEY=your-openai-api-key

# ====================
# AUTHENTICATION (CLERK)
# ====================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ====================
# STRIPE PAYMENTS
# ====================
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ====================
# OPTIONAL: GIPHY API
# ====================
# For GIF search functionality
GIPHY_API_KEY=your-giphy-api-key

# ====================
# WEBHOOK URL (OPTIONAL)
# ====================
# For RunPod job completion notifications
WEBHOOK_URL=https://your-domain.com/api/webhook
# Klipy (GIF / clip search)
NEXT_PUBLIC_KLIPY_API_KEY=
